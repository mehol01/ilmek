    },
    "Bir alışkanlık ekle; her gün yaptıkça serin uzasın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a habit and grow your streak every day you do it."
          }
        }
      }
    },
    "Bir alışkanlık ekleyince başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It starts once you add a habit."
          }
        }
      }
    },
    "Bir geri al": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo one"
          }
        }
      }
    },
    "Bir grup kur ve kodu arkadaşlarınla paylaş. Kimin bugün kaç ilmek attığını görün, birbirinizi motive edin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a group and share the code with friends. See who's knitted how many stitches today and keep each other going."
          }
        }
      }
    },
    "Birkaç günde bir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every few days"
          }
        }
      }
    },
    "Birkaç tane seç ya da boş başla. Sonra istediğin gibi düzenleyebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a few or start empty. You can change everything later."
          }
        }
      }
    },
    "Birlikte ör": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit together"
          }
        }
      }
    },
    "Bitiş": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until"
          }
        }
      }
    },
    "Bitiş saati başlangıçtan sonra olmalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End time must be after start time."
