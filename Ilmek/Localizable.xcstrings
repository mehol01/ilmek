    "Alışkanlıklarım": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My habits"
          }
        }
      }
    },
    "Alışkanlıkların güvende. Telefonun kilidini açtıktan sonra tekrar dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your habits are safe. Unlock your phone, then try again."
          }
        }
      }
    },
    "Alışkanlıkların ve geçmişin silinmez; sadece arkadaşlarla paylaşılan veriler silinir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your habits and history stay; only what you shared with friends is deleted."
          }
        }
      }
    },
    "Alışkanlıklarını işaretle, serini büyüt. Takvimde her günün nasıl geçtiğini gör. İstersen ayarlardan Örgü modunu aç; her gün atkına bir ilmek olarak eklensin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check off your habits and grow your streak. See how every day went on a calendar. Turn on Knit mode in settings to add each day to a scarf as a stitch."
          }
        }
      }
    },
    "Alışkanlıklarını çoğunlukla akşam yapıyorsun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mostly do your habits in the evening."
          }
        }
      }
    },
    "Alışkanlıklarını çoğunlukla sabah yapıyorsun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mostly do your habits in the morning."
          }
        }
      }
    },
    "Alışkanlıklarını çoğunlukla öğleden sonra yapıyorsun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mostly do your habits in the afternoon."
          }
        }
      }
    },
    "Aralıklı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At intervals"
          }
        }
