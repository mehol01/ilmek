        }
      }
    },
    "Bu alışkanlık ve tüm geçmişi silinsin mi?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this habit and all its history?"
          }
        }
      }
    },
    "Bu dönemde %lld kez tamamladın.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You completed a habit once in this period."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You completed habits %lld times in this period."
                }
              }
            }
          }
        }
      }
    },
    "Bu gruba katılamazsın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't join this group."
          }
        }
      }
    },
    "Bu işlem geri alınamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone."
          }
        }
      }
    },
    "Bu işlem geri alınamaz. Geçmişi saklamak için arşivleyebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone. Archive it to keep its history."
          }
        }
      }
    },
    "Bu kişiyi artık hiçbir grupta görmezsin ve onun bildirimleri gelmez. Profil ekranından engeli kaldırabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't see this person in any group, and you won't get their notifications. You can unblock them on the Profile screen."
          }
        }
      }
    },
    "Bu kodla bir grup bulunamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No group found with this code."
          }
        }
      }
    },
