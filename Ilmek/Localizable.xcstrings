    },
    "Arkadaşlar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        }
      }
    },
    "Arkadaşlarım günü bitirince haber ver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when friends finish their day"
          }
        }
      }
    },
    "Arkadaşlarımla paylaş": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with friends"
          }
        }
      }
    },
    "Arkadaşların ilerlemeni görebilsin diye bir takma ad gir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a nickname so your friends can see your progress."
          }
        }
      }
    },
    "Arkadaşların seni bu adla görür. Hesap ya da şifre yok; kimliğin iCloud'dan gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends see you by this name. No account or password — your identity comes from iCloud."
          }
        }
      }
    },
    "Arkadaşlarınla grup kurmak için Ayarlar'dan iCloud'a giriş yap. Alışkanlıkların bu cihazda çalışmaya devam eder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings to create groups with friends. Your habits keep working on this device."
          }
        }
      }
    },
    "Arkadaşının paylaştığı 8 karakterlik kodu gir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 8-character code your friend shared."
          }
        }
      }
    },
    "Arşiv": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive"
          }
        }
      }
    },
    "Arşivdekiler listede görünmez ama geçmişleri ve serileri durur. Geri almak için sağa kaydır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived habits are hidden from your list but keep their history and streaks. Swipe right to restore."
          }
        }
      }
    },
    "Arşivden çıkar": {
      "localizations": {
